# Copy to `.env` in the repo root to override defaults (optional for Docker Compose;
# compose already sets service URLs for the `localstack` Docker network).

# --- Host-native dev (see docs/local-dev.md Advanced) — use localhost LocalStack
AWS_ENDPOINT_URL=http://localhost:4566
QUEUE_URL=http://localhost:4566/000000000000/jobs
BUCKET_NAME=doc-storage
DYNAMODB_TABLE=ProcessLog
OTLP_ENDPOINT=localhost:4317

# Worker callback to ingestion (host: use 127.0.0.1; in Compose use http://ingestion:8000 via compose env)
INGESTION_BASE_URL=http://127.0.0.1:8000

# Ollama — Docker Compose sets OLLAMA_BASE_URL=http://ollama:11434 on ingestion/worker (see infra/docker-compose.yml).
# This file matters for host-run services and overrides Compose does not set:
# - Ingestion/worker on the host: http://localhost:11434 (or 127.0.0.1)
# - Host Ollama while apps in Docker: use a compose override; often http://host.docker.internal:11434 (see docs/local-dev.md)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:latest
# Long prompts / CPU inference can exceed 120s; raise if the worker times out first.
OLLAMA_HTTP_TIMEOUT_SECONDS=600

# CI / tests: deterministic LLM output for worker LangGraph
# LLM_MOCK_JSON={"classification":"Technical","summary":"..."}

# RAG / embeddings
CHROMA_PERSIST_DIR=.chroma_data
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# URL import (POST /import-url): set URL_IMPORT_ENABLED=false to disable
# URL_IMPORT_MAX_BYTES=10485760
# URL_IMPORT_MAX_REDIRECTS=5
# URL_IMPORT_TIMEOUT_SECONDS=30

# Frontend dev on host (Vite): proxy target for /api
# INGESTION_PROXY_TARGET=http://127.0.0.1:8000
