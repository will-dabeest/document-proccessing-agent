# Copy to `.env` in the repo root to override defaults (optional for Docker Compose;
# compose already sets service URLs for the `localstack` Docker network).

# --- Host-native dev (see docs/local-dev.md Advanced) — use localhost LocalStack
AWS_ENDPOINT_URL=http://localhost:4566
QUEUE_URL=http://localhost:4566/000000000000/jobs
BUCKET_NAME=doc-storage
DYNAMODB_TABLE=ProcessLog
OTLP_ENDPOINT=localhost:4317

# Worker callback to ingestion (host: use 127.0.0.1; in Compose use http://ingestion:8000 via compose env)
INGESTION_BASE_URL=http://127.0.0.1:8000

# Ollama (host install, or from `infra/`: `docker compose --profile llm up` then set http://ollama:11434 in overrides — see docs/local-dev.md)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# CI / tests: deterministic LLM output for worker LangGraph
# LLM_MOCK_JSON={"classification":"Technical","summary":"..."}

# RAG / embeddings
CHROMA_PERSIST_DIR=.chroma_data
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Frontend dev on host (Vite): proxy target for /api
# INGESTION_PROXY_TARGET=http://127.0.0.1:8000
